# Clé API Anthropic (optionnelle). Sans clé, l'assistant fonctionne en « mode local » :
# mêmes calculs déterministes, réponses rédigées par des gabarits au lieu du modèle.
ANTHROPIC_API_KEY=
# Modèle utilisé par l'orchestrateur.
ANTHROPIC_MODEL=claude-opus-5-5
# Active l'agent Recherche (recherche web côté Anthropic, sources citées).
ENABLE_WEB_SEARCH=false
# Mot de passe d'accès à l'application (fortement recommandé hors usage strictement local).
APP_PASSWORD=
# Emplacement de la base SQLite locale.
DATABASE_PATH=./data/finance.db

# ── Connexion bancaire en lecture seule (Enable Banking, agrégateur agréé DSP2) ──
# Identifiant de l'application créée sur https://enablebanking.com (c'est aussi le nom du fichier .pem).
ENABLE_BANKING_APP_ID=
# Chemin de la clé privée téléchargée à la création de l'application. À garder hors du dépôt.
ENABLE_BANKING_PRIVATE_KEY_PATH=./secrets/enablebanking.pem
# Adresse publique de l'application : sert à construire l'adresse de retour déclarée chez Enable Banking
# (APP_URL + /api/bank/callback).
APP_URL=http://localhost:3000
